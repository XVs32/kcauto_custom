/* kcauto_custom CUI — btop-style theme (stage 2)
   Uses only hex colours and long-term stable properties, avoiding design variables that depend on a specific Textual version. */

Screen {
    background: #0f1115;
    color: #c8ccd4;
}

/* ---- top status bar / bottom hint bar ------------------------------------------ */
#status {
    dock: top;
    height: 1;
    background: #181b21;
    padding: 0 0;
}

#hints {
    dock: bottom;
    height: 1;
    background: #181b21;
    padding: 0 1;
}

/* ---- main area (responsive) ---------------------------------------------------
   app.py adds classes on #main according to the terminal size:
   cols-1 ~ cols-4          number of card columns
   log-right / log-bottom / log-hidden   log position
   Rules and values are defined in layout.py: minimum card width 34, scrollbar 2, minimum log width 40,
   minimum log height 8. In right mode the #cards width = columns × 34 + 2. */

#main {
    height: 1fr;
}

#cards {
    grid-size: 2;
    grid-rows: auto;
    grid-gutter: 0;
    overflow-y: auto;
}

#log-box {
    border: round #4b5263;
    border-title-color: #c8ccd4;
    background: #0f1115;
    color: #c8ccd4;
    padding: 0 1;
}

#log-box:focus {
    border: heavy #c8ccd4;
}

#main.cols-1 #cards { grid-size: 1; }
#main.cols-2 #cards { grid-size: 2; }
#main.cols-3 #cards { grid-size: 3; }
#main.cols-4 #cards { grid-size: 4; }

/* Log on the right: the card area has a fixed width and the log takes the remaining width */
#main.log-right { layout: horizontal; }
#main.log-right #cards { height: 1fr; }
#main.log-right.cols-1 #cards { width: 36; }
#main.log-right.cols-2 #cards { width: 70; }
#main.log-right.cols-3 #cards { width: 104; }
#main.log-right.cols-4 #cards { width: 138; }
#main.log-right #log-box { width: 1fr; height: 1fr; }

/* Log below: the card area is as tall as its content and the log takes the remaining height */
#main.log-bottom { layout: vertical; }
#main.log-bottom #cards { width: 100%; height: auto; }
#main.log-bottom #log-box { width: 100%; height: 1fr; min-height: 8; }

/* Neither fits: hide the log */
#main.log-hidden { layout: vertical; }
#main.log-hidden #cards { width: 100%; height: 1fr; }
#main.log-hidden #log-box { display: none; }

/* Full-screen log: entered with l while the log is hidden (must come after the log-hidden rules to override them) */
#main.log-full { layout: vertical; }
#main.log-full #cards { display: none; }
#main.log-full #log-box { display: block; width: 100%; height: 1fr; }

/* ---- module boxes ---------------------------------------------------------- */
ModuleCard {
    width: 100%;
    height: auto;
    min-height: 4;
    padding: 0 1;
    border: round #4b5263;
}

ModuleCard:focus {
    background: #151922;
}

ModuleCard.off {
    color: #6b7280;
}

/* One accent colour per module: border, title, switch; the border gets thicker when focused */
ModuleCard.mod-combat          { border: round #e06c75; border-title-color: #e06c75; border-subtitle-color: #e06c75; }
ModuleCard.mod-expedition      { border: round #56b6c2; border-title-color: #56b6c2; border-subtitle-color: #56b6c2; }
ModuleCard.mod-pvp             { border: round #98c379; border-title-color: #98c379; border-subtitle-color: #98c379; }
ModuleCard.mod-quest           { border: round #e5c07b; border-title-color: #e5c07b; border-subtitle-color: #e5c07b; }
ModuleCard.mod-scheduler       { border: round #c678dd; border-title-color: #c678dd; border-subtitle-color: #c678dd; }
ModuleCard.mod-factory         { border: round #d19a66; border-title-color: #d19a66; border-subtitle-color: #d19a66; }
ModuleCard.mod-passive_repair  { border: round #61afef; border-title-color: #61afef; border-subtitle-color: #61afef; }
ModuleCard.mod-ship_switcher   { border: round #7fbbb3; border-title-color: #7fbbb3; border-subtitle-color: #7fbbb3; }
ModuleCard.mod-event_reset     { border: round #f4a6c0; border-title-color: #f4a6c0; border-subtitle-color: #f4a6c0; }
ModuleCard.mod-general         { border: round #abb2bf; border-title-color: #abb2bf; border-subtitle-color: #abb2bf; }

ModuleCard.mod-combat:focus          { border: heavy #e06c75; }
ModuleCard.mod-expedition:focus      { border: heavy #56b6c2; }
ModuleCard.mod-pvp:focus             { border: heavy #98c379; }
ModuleCard.mod-quest:focus           { border: heavy #e5c07b; }
ModuleCard.mod-scheduler:focus       { border: heavy #c678dd; }
ModuleCard.mod-factory:focus         { border: heavy #d19a66; }
ModuleCard.mod-passive_repair:focus  { border: heavy #61afef; }
ModuleCard.mod-ship_switcher:focus   { border: heavy #7fbbb3; }
ModuleCard.mod-event_reset:focus     { border: heavy #f4a6c0; }
ModuleCard.mod-general:focus         { border: heavy #abb2bf; }

/* Disabled modules: the border dims too (placed last to override the accent colour) */
ModuleCard.off {
    border: round #3b4252;
    border-title-color: #6b7280;
    border-subtitle-color: #6b7280;
}

ModuleCard.off:focus {
    border: heavy #6b7280;
}

/* ---- quit confirmation --------------------------------------------------------- */
ConfirmQuit {
    align: center middle;
    background: rgba(0, 0, 0, 0.55);
}

#quit-dialog {
    width: 40;
    height: auto;
    padding: 1 2;
    border: round #e5c07b;
    background: #181b21;
}

/* ---- editor (stage 4) -------------------------------------------------- */
EditorScreen {
    background: #0f1115;
    layout: vertical;
}

#ed-top {
    height: 1;
    background: #181b21;
}

#ed-body {
    height: 1fr;
}

#ed-left {
    width: 20;
    height: 100%;
    border: round #4b5263;
    border-title-color: #c8ccd4;
}

#ed-right {
    width: 1fr;
    height: 100%;
    border: round #4b5263;
}

ModuleList {
    width: 100%;
}

FormPane {
    width: 100%;
    height: 100%;
    background: #0f1115;
}

FieldRow {
    width: 100%;
    height: 1;
}

FieldRow:focus {
    background: #2a2f3a;
}

.grp {
    width: 100%;
    height: auto;
    margin-top: 1;
}

FormPane .grp:first-child {
    margin-top: 0;
}

#ed-help {
    height: auto;
    min-height: 5;
    max-height: 9;
    border: round #4b5263;
    padding: 0 1;
}

#ed-hints {
    height: 1;
    background: #181b21;
    padding: 0 1;
}

/* Window too narrow (< 72 columns): hide the module list on the left; switch modules with [ ] or ← → */
EditorScreen.narrow #ed-left {
    display: none;
}

/* ---- dialogs ------------------------------------------------------------- */
Dialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.55);
}

.dlg {
    width: 64;
    max-width: 96%;
    height: auto;
    max-height: 94%;
    padding: 1 2;
    border: round #e5c07b;
    background: #181b21;
}

.dlg-wide {
    width: 88;
}

.dlg-danger {
    border: round #e06c75;
}

.dlg-title {
    text-style: bold;
    color: #e8eaed;
    height: auto;
}

.dlg-help {
    color: #9aa0a6;
    height: auto;
    margin-bottom: 1;
}

#wheelrow {
    height: auto;
    layout: horizontal;
}

#wheelrow.stack {
    layout: vertical;
}

#wheelrow WheelPicker {
    width: auto;
}

#presetbox {
    width: 1fr;
    height: auto;
    margin-right: 2;
}

#wheelrow.stack #presetbox {
    width: 100%;
    margin-right: 0;
    margin-bottom: 1;
}

.dlg-meta {
    color: #6b7280;
    height: auto;
}

.dlg-colhead {
    color: #6b7280;
    height: 1;
}

.dlg-err {
    color: #e06c75;
    height: auto;
    min-height: 1;
}

.dlg-buttons {
    height: 1;
    margin-top: 1;
}

.action-label {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    background: #2a2f3a;
    color: #e8eaed;
}

.action-label:hover {
    background: #3a4150;
}

.action-label:focus {
    background: #e5c07b;
    color: #0f1115;
    text-style: bold;
}

.dlg Input {
    width: 100%;
}

PickList {
    width: 100%;
    background: #12151a;
}

PresetGrid {
    width: 100%;
    margin: 1 0;
}

#cells {
    height: auto;
}

#cells Input {
    width: 1fr;
    margin-right: 1;
}

CycleBox {
    width: 1fr;
    height: 3;
    margin-right: 1;
    border: tall #3b4252;
    background: #12151a;
}

CycleBox:focus {
    border: tall #e5c07b;
}

#recipe {
    height: auto;
}

.recipe-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

#json {
    height: 14;
}

/* ---- narrow window (stages 5-6) ------------------------------------------------ */
ModuleTabs {
    display: none;
    width: 100%;
    height: 1;
    background: #181b21;
}

EditorScreen.narrow ModuleTabs {
    display: block;
}

/* < 50 columns: every field takes two lines (label / value) */
EditorScreen.compact FieldRow {
    height: 2;
}

EditorScreen.compact .grp {
    margin-top: 0;
}

EditorScreen.compact #ed-help {
    min-height: 4;
    max-height: 7;
}

/* Narrow dialogs: less padding; table cells become vertical and take one row each */
Dialog.narrow .dlg {
    width: 100%;
    max-width: 100%;
    padding: 0 1;
}

Dialog.narrow .dlg-help {
    margin-bottom: 0;
}

Dialog.narrow #cells {
    layout: vertical;
    height: auto;
}

Dialog.narrow #cells Input {
    width: 100%;
    height: 1;
    border: none;
    margin: 0;
    padding: 0 1;
    background: #242932;
}

Dialog.narrow #cells CycleBox {
    width: 100%;
    height: 1;
    border: none;
    margin: 0;
}

Dialog.narrow .dlg-buttons {
    margin-top: 0;
}

/* The row whose value is being adjusted (second-level editing) */
FieldRow.editing {
    background: #3a4150;
}
